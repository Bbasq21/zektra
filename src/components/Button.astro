---
import Icon from './Icon.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'brand' | 'link';
  size?: 'sm' | 'md' | 'lg';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = false, type = 'button', class: cls, ...rest } = Astro.props;
const classes = ['button', `button--${variant}`, size !== 'md' && `button--${size}`, cls].filter(Boolean).join(' ');
const Tag = href ? 'a' : 'button';
---
<Tag class={classes} href={href} type={href ? undefined : type} data-magnetic={variant !== 'link' ? '' : undefined} {...rest}>
  <span class="button__label"><slot /></span>
  {arrow && <Icon name="arrow" size={18} class="button__icon" />}
</Tag>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 13px 22px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--fs-body-s);
    font-weight: 500;
    line-height: 20px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .button__icon { transition: transform var(--dur-fast) var(--ease-out); }
  .button:hover .button__icon { transform: translateX(3px); }

  .button--primary { background: var(--action); color: var(--on-action); }
  .button--primary:hover { background: var(--action-hover); box-shadow: var(--glow-action); }

  .button--brand { background: var(--brand-fill); color: var(--on-brand-fill); }
  .button--brand:hover { box-shadow: var(--glow-menta); }

  .button--ghost { background: transparent; color: var(--ink); border-color: var(--action); }
  .button--ghost:hover { background: rgba(255, 255, 255, 0.06); border-color: var(--action-hover); }

  .button--link { padding: 0; border: 0; border-radius: 0; background: none; color: var(--accent); }
  .button--link:hover .button__label { text-decoration: underline; text-underline-offset: 4px; }

  .button--sm { padding: 9px 16px; font-size: 14px; }
  .button--lg { padding: 16px 28px; font-size: 1rem; }

  .button:disabled, .button[aria-disabled='true'] { opacity: 0.45; pointer-events: none; box-shadow: none; }
</style>
