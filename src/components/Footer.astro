---
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <img class="footer__logo" src="/logos/zektra-horizontal-menta.svg" alt="Zektra — Soluciones Digitales" width="128" height="32" loading="lazy" />
      <p class="footer__promise">{SITE.promise}.</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Servicios</h2>
      <ul class="footer__list" role="list">
        {SERVICES.slice(0, 4).map((s) => <li><a class="footer__link" href={`/servicios/${s.id}/`}>{s.title}</a></li>)}
        <li><a class="footer__link" href="/servicios/">Todos los servicios</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Zektra</h2>
      <ul class="footer__list" role="list">
        <li><a class="footer__link" href="/casos/">Casos</a></li>
        <li><a class="footer__link" href="/nosotros/">Nosotros</a></li>
        <li><a class="footer__link" href="/blog/">Blog</a></li>
        <li><a class="footer__link" href="/contacto/">Contacto</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Contacto</h2>
      <ul class="footer__list" role="list">
        <li><a class="footer__link footer__link--accent" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li class="footer__text">{SITE.city}</li>
      </ul>
    </div>

    <div class="footer__legal">
      <span>© {year} Zektra · Soluciones Digitales</span>
      <span>Innovación que conecta.</span>
    </div>
  </div>
  <span class="footer__thread thread" aria-hidden="true"></span>
</footer>

<style>
  .footer { position: relative; border-top: 1px solid var(--line); background: var(--bg); }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--fs-body-s);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .footer__logo { height: 32px; width: auto; }
  .footer__promise { margin-top: var(--space-4); max-width: 28ch; }
  .footer__title { margin-bottom: var(--space-3); font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .footer__list { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; }
  .footer__link { color: var(--ink-2); text-decoration: none; transition: color var(--dur-fast) ease; }
  .footer__link:hover { color: var(--accent); }
  .footer__link--accent { color: var(--accent); }
  .footer__legal {
    grid-column: 1 / -1;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--fs-caption);
    color: var(--muted);
  }
  .footer__thread { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 0; }

  @media (max-width: 760px) {
    .footer__inner { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
</style>
