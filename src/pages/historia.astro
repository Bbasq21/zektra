---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { CHAPTERS } from '../data/story';

const last = CHAPTERS.length - 1;
---
<BaseLayout
  title="Nuestra historia"
  description="La historia de Zektra como un recorrido en 3D: de Medellín a tu proyecto, pasando por estrategia, diseño, desarrollo y evolución."
  breadcrumbs={[{ name: 'Nuestra historia', path: '/historia/' }]}
>
  <section class="story" data-story data-hero>
    <div class="story__stage" aria-hidden="true">
      <div class="story__backdrop"></div>
      <div class="story__scene" data-scene="world"></div>
      <div class="story__veil"></div>
    </div>

    <ol class="story__chapters" role="list">
      {CHAPTERS.map((c, i) => (
        <li class="story__chapter" id={c.id} data-story-chapter>
          <div class="story__frame container">
            <article class="story__card">
              <span class="eyebrow">{c.eyebrow}</span>
              {i === 0
                ? <h1 class="story__title story__title--lead" set:html={c.title} />
                : <h2 class="story__title" set:html={c.title} />}
              <p class="story__text">{c.text}</p>
              {c.tags && (
                <ul class="story__tags" role="list">
                  {c.tags.map((t) => <li class="tag">{t}</li>)}
                </ul>
              )}
              {i === last && (
                <div class="story__actions">
                  <Button href="/contacto/" variant="brand" size="lg" arrow>Agenda una llamada</Button>
                  <Button href="/servicios/" variant="ghost" size="lg">Ver servicios</Button>
                </div>
              )}
              {i === 0 && (
                <span class="story__hint" aria-hidden="true">
                  <span class="story__hint-line"></span>
                  Desliza para recorrer
                </span>
              )}
            </article>
          </div>
        </li>
      ))}
    </ol>

    <nav class="story__rail" aria-label="Capítulos de la historia">
      <ol class="story__rail-list" role="list">
        {CHAPTERS.map((c, i) => (
          <li>
            <a
              class="story__rail-link"
              href={`#${c.id}`}
              data-story-link
              style={`--chapter-accent: var(--${c.accent})`}
              aria-current={i === 0 ? 'step' : undefined}
            >
              <span class="story__rail-step">{c.step ?? ''}</span>
              <span class="story__rail-label">{c.label}</span>
              <span class="story__rail-dot" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>
</BaseLayout>

<script>
  import { initStory } from '../scripts/story';
  initStory();
</script>

<style>
  /* Bloque: story ------------------------------------------------------------
     Un escenario fijo (la escena 3D) detrás de capítulos largos. En escritorio cada
     capítulo ocupa varias pantallas y su tarjeta queda fija abajo a la izquierda mientras
     la cámara llega a la isla. En móvil, sin WebGL o con movimiento reducido, los
     capítulos se apilan como una página normal y el escenario es el resplandor en CSS. */
  .story { position: relative; isolation: isolate; background: var(--azul-noche); }

  .story__stage {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    overflow: hidden;
  }
  .story__backdrop {
    position: absolute;
    inset: -10% -10% -10% 20%;
    background: var(--gradient-aurora);
    filter: blur(30px);
    opacity: 0.5;
  }
  .story__scene { position: absolute; inset: 0; }
  .story__scene :global(canvas) { width: 100% !important; height: 100% !important; }
  .story__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(2, 3, 21, 0.8) 0%, rgba(2, 3, 21, 0.35) 36%, rgba(2, 3, 21, 0) 60%),
      linear-gradient(0deg, rgba(2, 3, 21, 0.75) 0%, rgba(2, 3, 21, 0) 32%);
  }
  :global(html.no-scenes) .story__scene { display: none; }
  :global(html.no-scenes) .story__backdrop { opacity: 0.9; }

  .story__chapters { position: relative; z-index: 1; margin: 0; padding: 0; }
  .story__chapter { padding-block: var(--space-8); }
  .story__chapter:first-child { padding-top: calc(var(--header-h) + var(--space-9)); }
  .story__chapter:last-child { padding-bottom: var(--space-9); }
  .story__frame { display: flex; align-items: flex-end; }

  .story__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    width: 100%;
    max-width: 36rem;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgba(10, 12, 36, 0.74);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--shadow-card);
  }
  .story__title { font-size: var(--fs-h1); line-height: 1.1; color: var(--ink); }
  .story__title--lead { font-size: var(--fs-display-l); line-height: 1.06; letter-spacing: -0.03em; }
  .story__title :global(strong) { font-style: italic; font-weight: 700; color: var(--accent); }
  .story__text { max-width: 52ch; color: var(--ink-2); }
  .story__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; }
  .story__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }

  .story__hint {
    display: none;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .story__hint-line { position: relative; width: 48px; height: 1px; overflow: hidden; background: var(--line-strong); }
  .story__hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--menta);
    animation: story-hint 2.2s var(--ease-out) infinite;
  }
  @keyframes story-hint { 0% { transform: translateX(-100%); } 60%, 100% { transform: translateX(100%); } }

  /* Riel de capítulos: solo en el recorrido 3D */
  .story__rail { display: none; position: absolute; top: 0; bottom: 0; right: var(--gutter); z-index: 2; pointer-events: none; }
  .story__rail-list {
    position: sticky;
    top: 50vh;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(2, 3, 21, 0.6);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transform: translateY(-50%);
    pointer-events: auto;
  }
  .story__rail-link {
    display: grid;
    grid-template-columns: auto auto 10px;
    justify-content: end;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-caption);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) ease;
  }
  .story__rail-link:hover { color: var(--ink-2); }
  .story__rail-step { font-variant-numeric: tabular-nums; color: var(--line-strong); }
  .story__rail-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    transition: background-color var(--dur) ease, border-color var(--dur) ease, box-shadow var(--dur) ease;
  }
  .story__rail-link[aria-current] { color: var(--ink); }
  .story__rail-link[aria-current] .story__rail-dot {
    background: var(--chapter-accent);
    border-color: var(--chapter-accent);
    box-shadow: 0 0 12px var(--chapter-accent);
  }

  /* Recorrido 3D en escritorio. La altura de los capítulos depende solo de CSS para que la
     página no salte al cargar; el script añade story--live para mostrar y ocultar tarjetas. */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    :global(html:not(.no-scenes)) .story__chapter { height: 240vh; height: 240svh; padding-block: 0; }
    :global(html:not(.no-scenes)) .story__chapter:last-child { height: 220vh; height: 220svh; }
    :global(html:not(.no-scenes)) .story__frame {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      padding-block: calc(var(--header-h) + var(--space-6)) var(--space-8);
    }
  }

  .story--live .story__card {
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .story--live .story__chapter.is-active .story__card,
  .story--live .story__card:focus-within {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .story--live .story__hint { display: inline-flex; }
  .story--live .story__rail { display: block; }

  @media (max-width: 720px) {
    .story__card { padding: var(--space-5); }
    .story__veil { background: linear-gradient(0deg, rgba(2, 3, 21, 0.9) 0%, rgba(2, 3, 21, 0.55) 55%, rgba(2, 3, 21, 0.3) 100%); }
  }
</style>
