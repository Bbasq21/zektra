---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { CASES } from '../data/cases';
---
<BaseLayout
  title="Casos"
  description="Proyectos de Zektra: plataformas, migraciones, prototipos y sitios administrables para empresas en Colombia."
>
  <Hero
    eyebrow="Casos"
    title="Ideas que ya son <strong>soluciones digitales</strong>"
    lead="Por confidencialidad no mostramos los nombres de nuestros clientes. Sí te contamos el reto, lo que hicimos y lo que entregamos."
  />

  <section class="section">
    <div class="container case-list">
      {CASES.map((c, i) => <CaseCard item={c} index={i} detailed />)}
    </div>
  </section>

  <CtaBand title="¿Tu proyecto puede ser el siguiente?" text="Si tienes un reto parecido, o uno que no se parece a nada, conversemos." label="Contar mi proyecto" />
</BaseLayout>

<style>
  .case-list { display: flex; flex-direction: column; gap: var(--space-6); }
</style>
