---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../data/blog';
import { SERVICES } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 2) } }));
}

interface Props { post: Post; others: Post[] }
const { post, others } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const service = data.service ? SERVICES.find((s) => s.id === data.service) : undefined;
const serviceIndex = service ? SERVICES.indexOf(service) : 0;
const url = new URL(`/blog/${post.id}/`, Astro.site).toString();
const orgId = `${new URL('/', Astro.site)}#organizacion`;

const postingSchema = {
  '@type': 'BlogPosting',
  '@id': `${url}#articulo`,
  headline: data.title,
  description: data.description,
  url,
  mainEntityOfPage: { '@id': `${url}#pagina` },
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  inLanguage: 'es-CO',
  author: { '@id': orgId },
  publisher: { '@id': orgId },
  image: new URL('/og.png', Astro.site).toString(),
  keywords: data.tags.join(', ') || undefined,
  wordCount: (post.body ?? '').trim().split(/\s+/).length,
  isPartOf: { '@id': `${new URL('/blog/', Astro.site)}#blog` },
  ...(service ? { about: { '@type': 'Service', name: service.title, url: new URL(`/servicios/${service.id}/`, Astro.site).toString() } } : {}),
};
---
<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  breadcrumbs={[
    { name: 'Blog', path: '/blog/' },
    { name: data.title, path: `/blog/${post.id}/` },
  ]}
  schema={[postingSchema]}
  article={{ published: data.pubDate, modified: data.updatedDate, tags: data.tags }}
>
  <Hero eyebrow="Blog" title={data.title} lead={data.description} />

  <section class="section">
    <div class="container article-layout">
      <aside class="article-aside">
        <nav class="crumbs" aria-label="Ruta de navegación">
          <ol class="crumbs__list" role="list">
            <li><a class="crumbs__link" href="/">Inicio</a></li>
            <li><a class="crumbs__link" href="/blog/">Blog</a></li>
          </ol>
        </nav>
        <p class="article-meta">
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time><br />
          {data.updatedDate && <>Actualizado: <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time><br /></>}
          {readingTime(post.body)} min de lectura
        </p>
        {toc.length > 2 && (
          <nav class="toc" aria-label="En este artículo">
            <p class="toc__title">En este artículo</p>
            <ol class="toc__list" role="list">
              {toc.map((h) => <li><a class="toc__link" href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
      </aside>

      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  {(service || others.length > 0) && (
    <section class="section section--surface">
      <div class="container related">
        {service && (
          <div>
            <p class="related__title">Servicio relacionado</p>
            <ServiceCard service={service} index={serviceIndex} />
          </div>
        )}
        {others.length > 0 && (
          <div>
            <p class="related__title">Sigue leyendo</p>
            <ul class="related__posts" role="list">
              {others.map((p) => (
                <li><a class="related__post" href={`/blog/${p.id}/`}>{p.data.title} <span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  .article-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  .article-aside { position: sticky; top: calc(var(--header-h) + var(--space-5)); display: flex; flex-direction: column; gap: var(--space-5); font-size: var(--fs-body-s); }
  .crumbs__list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; font-size: var(--fs-caption); }
  .crumbs__list li + li::before { content: '/'; margin-right: var(--space-2); color: var(--line-strong); }
  .crumbs__link { color: var(--ink-2); text-decoration: none; }
  .crumbs__link:hover { color: var(--accent); }
  .article-meta { color: var(--muted); line-height: 1.7; }
  .toc { padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .toc__title { margin-bottom: var(--space-3); font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .toc__list { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; padding: 0; }
  .toc__link { color: var(--ink-2); text-decoration: none; line-height: 1.4; }
  .toc__link:hover { color: var(--accent); }

  .prose { max-width: 70ch; font-size: var(--fs-body); line-height: 1.7; color: var(--ink-2); }
  .prose :global(> * + *) { margin-top: var(--space-5); }
  .prose :global(h2) { margin-top: var(--space-8); font-size: var(--fs-h2); line-height: 1.2; color: var(--ink); scroll-margin-top: calc(var(--header-h) + var(--space-5)); }
  .prose :global(h3) { margin-top: var(--space-7); font-size: var(--fs-h4); line-height: 1.3; color: var(--ink); scroll-margin-top: calc(var(--header-h) + var(--space-5)); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-5); }
  .prose :global(li + li) { margin-top: var(--space-2); }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(blockquote) { padding: var(--space-5); border-left: 2px solid var(--accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: var(--surface); color: var(--ink); }
  .prose :global(code) { padding: 2px 6px; border-radius: 6px; background: var(--surface-2); font-size: 0.9em; color: var(--ink); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: var(--fs-body-s); display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .prose :global(th) { color: var(--ink); font-weight: 600; }

  .related { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  .related__title { margin-bottom: var(--space-4); font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .related__posts { display: flex; flex-direction: column; gap: var(--space-3); margin: 0; padding: 0; }
  .related__post { display: block; padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--bg, var(--surface)); color: var(--ink); font-weight: 500; text-decoration: none; }
  .related__post:hover { border-color: var(--line-strong); color: var(--accent); }

  @media (max-width: 1024px) {
    .article-layout, .related { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .article-aside { position: static; }
    .toc { display: none; }
  }
</style>
