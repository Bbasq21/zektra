---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, type Service } from '../../data/services';
import { CASES } from '../../data/cases';
import { SERVICE_DETAILS } from '../../data/service-details';
import CaseCard from '../../components/CaseCard.astro';
import { getPosts } from '../../data/blog';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const url = new URL(`/servicios/${service.id}/`, Astro.site).toString();
const related = SERVICES.filter((s) => s.id !== service.id).slice(0, 3);
const relatedIndex = (s: Service) => SERVICES.findIndex((x) => x.id === s.id);
const detail = SERVICE_DETAILS[service.id];
const cases = CASES.filter((c) => c.service === service.id);
const faqs = service.faqs ?? [];
const posts = (await getPosts()).filter((p) => p.data.service === service.id);
const faqSchema = faqs.length
  ? [{
      '@type': 'FAQPage',
      '@id': `${url}#preguntas`,
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }]
  : [];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${url}#servicio`,
  name: service.title,
  serviceType: service.title,
  description: detail ? `${detail.intro} ${service.description}` : `${service.summary} ${service.description}`,
  url,
  provider: { '@id': `${new URL('/', Astro.site)}#organizacion` },
  areaServed: [
    { '@type': 'City', name: 'Medellín' },
    { '@type': 'Country', name: 'Colombia' },
  ],
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: new URL('/contacto/', Astro.site).toString(), availableLanguage: 'es' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Qué incluye: ${service.title}`,
    itemListElement: service.deliverables.map((d) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: d } })),
  },
};
---
<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  breadcrumbs={[
    { name: 'Servicios', path: '/servicios/' },
    { name: service.title, path: `/servicios/${service.id}/` },
  ]}
  schema={[serviceSchema, ...faqSchema]}
>
  <Hero eyebrow="Servicios" title={service.heading} lead={service.summary}>
    <Button href={`/contacto/?servicio=${service.id}`} size="lg" arrow>Cotizar este servicio</Button>
    <Button href="/servicios/" variant="ghost" size="lg">Ver todos los servicios</Button>
  </Hero>

  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <ol class="crumbs__list" role="list">
          <li><a class="crumbs__link" href="/">Inicio</a></li>
          <li><a class="crumbs__link" href="/servicios/">Servicios</a></li>
          <li aria-current="page">{service.title}</li>
        </ol>
      </nav>

      <div class="service-page">
        <div class="service-page__main">
          <span class="service-page__icon" aria-hidden="true"><Icon name={service.icon} size={28} /></span>
          <h2 class="service-page__title" data-split>Qué hacemos</h2>
          {detail && <p class="service-page__text service-page__text--lead" data-reveal>{detail.intro}</p>}
          {!detail && <p class="service-page__text" data-reveal>{service.description}</p>}
          <p class="service-page__text" data-reveal>
            Trabajamos desde {SITE.city}. Usamos inteligencia artificial para ir más rápido,
            y cada entrega pasa por revisión humana antes de llegar a tus manos.
          </p>
        </div>

        <aside class="service-page__meta" data-reveal>
          <h2 class="service-page__label">Qué incluye</h2>
          <ul class="service-page__list" role="list">
            {service.deliverables.map((d) => <li class="service-page__item">{d}</li>)}
          </ul>
          <h2 class="service-page__label">Herramientas</h2>
          <ul class="service-page__tags" role="list">
            {service.stack.map((t) => <li class="tag tag--outline">{t}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {detail && (
    <section class="section section--surface">
      <div class="container service-page__needs">
        <SectionHead eyebrow="Cuándo lo necesitas" title="Señales de que es el momento" />
        <ul class="needs" role="list">
          {detail.needs.map((n) => (
            <li class="needs__item" data-reveal>
              <span class="needs__icon" aria-hidden="true"><Icon name="check" size={18} /></span>
              <span>{n}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {detail && (
    <section class="section">
      <div class="container">
        <SectionHead eyebrow="Cómo lo trabajamos" title="Paso a paso, sin sorpresas" lead="Sabes en qué etapa está tu proyecto, qué sigue y qué necesitamos de ti." />
        <ol class="approach" role="list">
          {detail.approach.map((a, i) => (
            <li class="approach__step" data-reveal>
              <span class="approach__number">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="approach__title">{a.title}</h3>
              <p class="approach__text">{a.text}</p>
            </li>
          ))}
        </ol>
        <div class="outcome" data-reveal>
          <h2 class="outcome__title">Qué recibes al final</h2>
          <p class="outcome__text">{detail.outcome}</p>
        </div>
      </div>
    </section>
  )}

  {cases.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead eyebrow="Casos" title="Así lo hemos aplicado" lead="Por confidencialidad no nombramos a nuestros clientes; sí contamos qué hicimos." />
        <div class="service-page__cases">
          {cases.map((c) => <CaseCard item={c} index={CASES.indexOf(c)} detailed />)}
        </div>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <p class="service-page__label">Del blog</p>
        <ul class="service-page__posts" role="list">
          {posts.map((p) => <li><a class="service-page__post" href={`/blog/${p.id}/`}>{p.data.title} <span aria-hidden="true">→</span></a></li>)}
        </ul>
      </div>
    </section>
  )}

  {faqs.length > 0 && (
    <section class="section">
      <div class="container container--narrow">
        <SectionHead eyebrow="Preguntas frecuentes" title="Lo que suelen preguntarnos" />
        <div class="faq">
          {faqs.map((f) => (
            <details class="faq__item">
              <summary class="faq__question">{f.q}</summary>
              <p class="faq__answer">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Otros servicios" title="Capacidades que trabajan juntas" />
      <div class="service-page__related">
        {related.map((s) => <ServiceCard service={s} index={relatedIndex(s)} />)}
      </div>
    </div>
  </section>

  <CtaBand text="Cuéntanos el problema, no la solución. Te proponemos el camino y el alcance." />
</BaseLayout>

<style>
  .crumbs { margin-bottom: var(--space-7); font-size: var(--fs-caption); color: var(--muted); }
  .crumbs__list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  .crumbs__list li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .crumbs__list li + li::before { content: '/'; color: var(--line-strong); }
  .crumbs__link { color: var(--ink-2); text-decoration: none; }
  .crumbs__link:hover { color: var(--accent); }

  .service-page { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 4fr); gap: var(--space-8); align-items: start; }
  .service-page__main { display: flex; flex-direction: column; gap: var(--space-5); }
  .service-page__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--accent); }
  .service-page__title { font-size: var(--fs-h2); }
  .service-page__text { color: var(--ink-2); max-width: 62ch; font-size: var(--fs-lead); line-height: 1.55; }
  .service-page__meta { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .service-page__label { font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .service-page__label:not(:first-child) { margin-top: var(--space-4); }
  .service-page__list { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; padding: 0; }
  .service-page__item { position: relative; padding-left: var(--space-5); color: var(--ink-2); }
  .service-page__item::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 12px; height: 2px; border-radius: 2px; background: var(--gradient-oficial); }
  .service-page__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }

  .service-page__text--lead { color: var(--ink); }

  .service-page__needs { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: var(--space-8); align-items: start; }
  .service-page__needs :global(.section-head) { margin-bottom: 0; }
  .needs { display: flex; flex-direction: column; gap: var(--space-4); margin: 0; padding: 0; }
  .needs__item { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: var(--space-4); align-items: start; padding-bottom: var(--space-4); border-bottom: 1px solid var(--line); color: var(--ink); font-size: var(--fs-lead); line-height: 1.5; }
  .needs__item:last-child { border-bottom: 0; padding-bottom: 0; }
  .needs__icon { display: grid; place-items: center; width: 32px; height: 32px; margin-top: 2px; border-radius: 999px; background: var(--surface-2); color: var(--accent); }

  .approach { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); margin: 0; padding: 0; counter-reset: none; }
  .approach__step { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6) var(--space-5) var(--space-5); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .approach__step::before { content: ''; position: absolute; inset: -1px -1px auto; height: 2px; border-radius: var(--radius-md) var(--radius-md) 0 0; background: var(--gradient-oficial); opacity: 0.8; }
  .approach__number { font-size: var(--fs-h3); font-weight: 600; line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  .approach__title { font-size: var(--fs-h4); line-height: 1.3; }
  .approach__text { color: var(--ink-2); font-size: var(--fs-body-s); line-height: 1.6; }

  .outcome { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-7); align-items: baseline; margin-top: var(--space-7); padding: var(--space-6) var(--space-7); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-2); }
  .outcome__title { font-size: var(--fs-h3); }
  .outcome__text { color: var(--ink); font-size: var(--fs-lead); line-height: 1.55; }
  .service-page__posts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin: var(--space-4) 0 0; padding: 0; }
  .service-page__post { display: block; height: 100%; padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); color: var(--ink); font-weight: 500; text-decoration: none; }
  .service-page__post:hover { border-color: var(--line-strong); color: var(--accent); }
  @media (max-width: 640px) { .approach { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) { .service-page__posts { grid-template-columns: minmax(0, 1fr); } }
  .service-page__cases { display: flex; flex-direction: column; gap: var(--space-6); }
  .faq { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__question { padding: var(--space-5) 0; color: var(--ink); font-size: var(--fs-h4); font-weight: 500; cursor: pointer; }
  .faq__question:hover { color: var(--accent); }
  .faq__answer { padding-bottom: var(--space-5); color: var(--ink-2); max-width: 65ch; }
  .service-page__related { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }

  @media (max-width: 1024px) {
    .service-page, .service-page__needs, .outcome { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .approach { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .outcome { gap: var(--space-4); padding: var(--space-6); }
    .service-page__related { grid-template-columns: minmax(0, 1fr); }
  }
</style>
